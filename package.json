{
  "name": "orbita-chat",
  "version": "0.5.1",
  "private": true,
  "description": "Chat, voz e compartilhamento de tela em Electron",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.cjs",
    "test": "node --test",
    "pack:win": "electron-builder --win nsis",
    "pack:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "happy-dom": "^21.0.4",
    "lucide-static": "^1.55.0"
  },
  "build": {
    "appId": "dev.fmm.orbita",
    "productName": "Órbita",
    "files": [
      "assets/**/*",
      "electron/**/*",
      "renderer/**/*",
      "server/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/orbita-icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "assets/orbita-icon.png"
    }
  }
}
